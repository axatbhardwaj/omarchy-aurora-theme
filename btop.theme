# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#edf7ef"

# Title color for boxes
theme[title]="#85d9ac"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7dd6c8"

# Background color of selected item in processes box
theme[selected_bg]="#1f2a26"

# Foreground color of selected item in processes box
theme[selected_fg]="#85d9ac"

# Color of inactive/disabled text
theme[inactive_fg]="#b0c8bc"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#a8f0b3"

# Box outline and divider line color
theme[cpu_box]="#6fd48c"
theme[mem_box]="#6fd48c"
theme[net_box]="#6fd48c"
theme[proc_box]="#6fd48c"
theme[div_line]="#727773"

# Gradient for all meters and graphs
theme[temp_start]="#7dd6c8"
theme[temp_mid]="#85d9ac"
theme[temp_end]="#6fd48c"


theme[cpu_start]="#7dd6c8"
theme[cpu_mid]="#85d9ac"
theme[cpu_end]="#6fd48c"


theme[free_start]="#85d9ac"
theme[free_mid]="#6fd48c"
theme[free_end]="#a8f0b3"


theme[cached_start]="#93d2ec"
theme[cached_mid]="#93d2ec"
theme[cached_end]="#93d2ec"


theme[available_start]="#7dd6c8"
theme[available_mid]="#7dd6c8"
theme[available_end]="#7dd6c8"


theme[used_start]="#85d9ac"
theme[used_mid]="#5fb3d9"
theme[used_end]="#e0b283"


theme[download_start]="#5fb3d9"
theme[download_mid]="#7dd6c8"
theme[download_end]="#85d9ac"


theme[upload_start]="#5fb3d9"
theme[upload_mid]="#7dd6c8"
theme[upload_end]="#85d9ac"